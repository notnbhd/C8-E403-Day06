# Copy this file to `.env` and fill in real values.

# Supabase REST API client settings.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# Supabase Postgres connection for SQLAlchemy and Alembic migrations.
# In Supabase Dashboard, copy the Transaction pooler URI from Connect.
# Keep the `postgresql+psycopg://` prefix because this project uses psycopg.
DATABASE_URL=postgresql+psycopg://postgres.your-project-ref:your-db-password@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

# Gemini is used for embeddings / generation in app.py and ingest.py.
GEMINI_API_KEY=your-gemini-api-key

# OpenAI-compatible custom LLM endpoint used by app.py.
CUSTOM_LLM_KEY=your-custom-llm-api-key
CUSTOM_LLM_URL=https://openrouter.ai/api/v1
CUSTOM_LLM_MODEL=mistral-small-latest

# Agent tools backend: 1 = mock data (offline), 0 = read/write real Supabase
# (needs DATABASE_URL + `alembic upgrade head` + `python -m db.seed`).
AGENT_USE_MOCK_TOOLS=0
