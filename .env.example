# Copy this file to `.env` and fill values before running the demo
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key
# Postgres connection string for SQLAlchemy (Supabase provides this in the project settings)
DATABASE_URL=postgresql://user:password@db.host:5432/database
